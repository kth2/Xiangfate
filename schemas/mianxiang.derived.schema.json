{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiangfate.app/schemas/mianxiang.derived.schema.json",
  "title": "MianxiangDerived",
  "description": "面相模块的综合判定，填入 AnalysisEnvelope.derived。",
  "type": "object",
  "required": ["fiveElements", "faceShape", "courtDominance", "symmetryScore"],
  "additionalProperties": false,
  "properties": {
    "fiveElements": {
      "type": "object",
      "description": "五形软分类。primaryScore < 0.55 时 primary 应为「兼形」。",
      "required": ["primary", "primaryScore"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "enum": ["金", "木", "水", "火", "土", "兼形"] },
        "primaryScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "secondary": { "type": ["string", "null"], "enum": ["金", "木", "水", "火", "土", null] },
        "secondaryScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "faceShape": {
      "type": "string",
      "enum": ["圆脸", "瓜子脸", "由字脸", "国字脸", "甲字脸"],
      "description": "沿用 lincerely/Face-Reading 词表。"
    },
    "courtDominance": {
      "type": "string",
      "enum": ["upper", "middle", "lower", "balanced"],
      "description": "三停中占优的一停。"
    },
    "symmetryScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "clamp(1 - 镜像平均偏差/0.08, 0, 1)。≥0.85 视为「五官端正」。"
    },
    "palaceHighlights": {
      "type": "array",
      "items": { "$ref": "#/$defs/Palace" },
      "maxItems": 3,
      "description": "得分最高的 2-3 宫。"
    },
    "palaceCautions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Palace" },
      "maxItems": 2,
      "description": "得分最低的 1-2 宫。措辞须温和。"
    },
    "hairlineSource": {
      "type": "string",
      "enum": ["mesh_top", "segmentation"],
      "description": "发际线来源。mesh_top（landmark 10）精度较低，上停 methodPrior 仅 0.65。"
    }
  },
  "$defs": {
    "Palace": {
      "type": "string",
      "enum": [
        "命宫", "财帛宫", "兄弟宫", "田宅宫", "男女宫", "疾厄宫",
        "迁移宫", "奴仆宫", "官禄宫", "福德宫", "相貌宫", "父母宫"
      ]
    }
  }
}
